VITE_BASE=/Starjet_SOC_MBP/

# 接口地址
#VITE_GLOB_API_URL=https://mock-napi.vben.pro/api
VITE_GLOB_API_URL=/api

# GitHub Pages 正式 Demo 为纯静态站点，登录与权限数据由前端演示模式提供。
VITE_STATIC_DEMO_AUTH=true

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=false
